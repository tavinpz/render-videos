{
"total": 42.17,
"frases": [
{
"k": "hook",
"t0": 0.05,
"t1": 2.702,
"txt": "Your dog didn't pick the end of your bed by accident."
},
{
"k": "best",
"t0": 2.802,
"t1": 4.955,
"txt": "To him, it's the best spot in the whole house."
},
{
"k": "anc",
"t0": 5.075,
"t1": 7.804,
"txt": "Long before beds, his ancestors slept in a pile."
},
{
"k": "close",
"t0": 7.864,
"t1": 10.593,
"txt": "Close together. Warm. Nobody slept alone."
},
{
"k": "alone",
"t0": 10.643,
"t1": 11.758,
"txt": "Alone meant danger."
},
{
"k": "pack",
"t0": 11.898,
"t1": 14.211,
"txt": "Your bed is his pile now. And you are his pack."
},
{
"k": "but",
"t0": 14.351,
"t1": 16.144,
"txt": "But here's the part nobody tells you."
},
{
"k": "film",
"t0": 16.224,
"t1": 18.79,
"txt": "Scientists filmed dogs sleeping, all night long."
},
{
"k": "woke",
"t0": 18.84,
"t1": 20.856,
"txt": "They woke up twenty-three times in eight hours."
},
{
"k": "cycle",
"t0": 20.916,
"t1": 24.31,
"txt": "Sixteen minutes asleep. Five minutes awake. Over and over."
},
{
"k": "near",
"t0": 24.39,
"t1": 27.101,
"txt": "And they slept as close to their owners as they were allowed."
},
{
"k": "roll",
"t0": 27.221,
"t1": 29.342,
"txt": "So every time you roll over, he feels it."
},
{
"k": "noise",
"t0": 29.422,
"t1": 32.554,
"txt": "A noise in the hallway? His head is up before your eyes open."
},
{
"k": "feet",
"t0": 32.654,
"t1": 35.342,
"txt": "At your feet, he can feel you, and still watch the door."
},
{
"k": "clingy",
"t0": 35.462,
"t1": 36.339,
"txt": "That's not clingy."
},
{
"k": "keep",
"t0": 36.379,
"t1": 38.514,
"txt": "That's him keeping his pack together, all night."
},
{
"k": "cta",
"t0": 38.674,
"t1": 41.567,
"txt": "Send this to someone whose dog never leaves their feet."
}
],
